<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Player List View -->
    <record id="view_tournament_player_list" model="ir.ui.view">
        <field name="name">tournament.player.list</field>
        <field name="model">tournament.player</field>

        <field name="arch" type="xml">
            <list>
                <field name="full_name"/>
                <field name="gamer_tag"/>
                <field name="email"/>
                <field name="team_id"/>
            </list>
        </field>
    </record>


    <!-- Player Form View -->
    <record id="view_tournament_player_form" model="ir.ui.view">
        <field name="name">tournament.player.form</field>
        <field name="model">tournament.player</field>

        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="full_name"/>
                        <field name="gamer_tag"/>
                        <field name="email"/>
                        <field name="team_id"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="action_tournament_player" model="ir.actions.act_window">
        <field name="name">Players</field>
        <field name="res_model">tournament.player</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>